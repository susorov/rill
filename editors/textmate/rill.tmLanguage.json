{
  "name": "rill",
  "scopeName": "source.rill",
  "fileTypes": [
    "rill"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.rill",
      "match": "//[^\\r\\n]*"
    },
    {
      "name": "keyword.declaration.rill",
      "match": "\\blet\\b"
    },
    {
      "name": "keyword.operator.comparison.rill",
      "match": "==|!=|>=|<=|>"
    },
    {
      "name": "constant.language.boolean.rill",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric.float.rill",
      "match": "(?<![\\w.])-?[0-9]+\\.[0-9]+\\b"
    },
    {
      "name": "constant.numeric.integer.rill",
      "match": "(?<![\\w.])-?[0-9]+\\b"
    },
    {
      "name": "string.quoted.double.rill",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "entity.name.function.rill",
      "match": "\\bprint(?=\\s*\\()"
    }
  ]
}
