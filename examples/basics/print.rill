// Print integer variables
let count = 42
let limit = count

print(count)
print(limit)

// Print an empty line
print()

// Print boolean variables
let enabled = true
let active = enabled

print(enabled)
print(active)

// Print a string variable
let message = "Hello, Rill!"
print(message)

// Print literals directly
print(-42)
print(true)
print(false)
print("No variable needed")

// An empty string also prints an empty line
print("")
